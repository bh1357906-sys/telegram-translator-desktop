{
  "name": "telegram-translator-desktop",
  "version": "0.1.12",
  "description": "Telegram Web desktop translator: auto-translate incoming messages to your language, and translate your drafts to the contact's language. Bring your own DeepSeek key.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "author": "bh1357906-sys",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shopbharat.tgtranslator",
    "productName": "TG Translator",
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "settings.js",
      "settings-preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
