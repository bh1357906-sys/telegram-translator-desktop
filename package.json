{
  "name": "telegram-translator-desktop",
  "version": "0.9.0",
  "description": "Telegram Web desktop translator: auto-translate incoming messages to your language, and translate your drafts to the contact's language. Bring your own DeepSeek / OpenAI / Gemini key.",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/build-preload.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "author": "bh1357906-sys",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.shopbharat.tgtranslator",
    "productName": "TG Translator",
    "files": [
      "main.js",
      "preload.js",
      "dist-preload/**/*",
      "core/**/*",
      "settings.html",
      "settings.js",
      "settings-preload.js",
      "shell.html",
      "shell.js",
      "shell-preload.js",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "tg-translator-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bh1357906-sys",
        "repo": "telegram-translator-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  }
}
